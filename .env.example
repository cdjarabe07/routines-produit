# Source des données : demo (localStorage, données fictives) | api (backend REST)
VITE_DATA_MODE=demo
# Obligatoire si VITE_DATA_MODE=api
VITE_API_BASE_URL=
# Authentification : demo (choix de profil, AUCUNE sécurité) | oidc (à brancher)
VITE_AUTH_MODE=demo
# Tableau BI intégré (laisser vide = non connecté)
VITE_BI_EMBED_URL=
VITE_BI_ALLOWED_ORIGIN=
# debug | info | warn | error
VITE_LOG_LEVEL=warn
