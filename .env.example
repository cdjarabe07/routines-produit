# Toutes les variables VITE_* sont intégrées au code livré au navigateur : elles sont PUBLIQUES.
# N'y mettez jamais de secret (clé de service, mot de passe, jeton). L'application refuse de démarrer
# si une clé Supabase secrète est placée dans VITE_SUPABASE_PUBLISHABLE_KEY.

# Source des données : demo (stockage du navigateur, AUCUNE sécurité) | supabase (serveur, RLS) | api (backend REST)
VITE_DATA_MODE=demo
# Obligatoire si VITE_DATA_MODE=api
VITE_API_BASE_URL=
# Authentification : demo (comptes simulés, AUCUNE sécurité) | supabase (Supabase Auth) | oidc (à brancher)
# supabase doit être utilisé avec VITE_DATA_MODE=supabase
VITE_AUTH_MODE=demo

# Mode supabase : URL du projet et clé PUBLIQUE (publishable / anon). Jamais la clé service_role ni sb_secret_.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Facultatif : domaine ajouté à un identifiant court (« nadia.roussel » → « nadia.roussel@atelier.local »)
VITE_AUTH_EMAIL_DOMAIN=

# Tableau BI intégré (laisser vide = non connecté). Ajouter son origine à frame-src dans vercel.json.
VITE_BI_EMBED_URL=
VITE_BI_ALLOWED_ORIGIN=
# debug | info | warn | error
VITE_LOG_LEVEL=warn
